# Copy this file to .env and adjust values for your local environment.
# .env is gitignored (see .gitignore): never commit real secrets, only this
# example file with placeholder values.
#
# docker compose reads .env automatically from the project root to fill in
# the ${VAR} references in docker-compose.yml.

POSTGRES_DB=spring_webflux_tutorial
POSTGRES_USER=spring_webflux_tutorial
POSTGRES_PASSWORD=spring_webflux_tutorial

R2DBC_URL=r2dbc:postgresql://db:5432/spring_webflux_tutorial
FLYWAY_URL=jdbc:postgresql://db:5432/spring_webflux_tutorial
DB_USERNAME=spring_webflux_tutorial
DB_PASSWORD=spring_webflux_tutorial

# HMAC signing key for JWTs (feature/auth). Generate a real random value for any
# non-local environment, this placeholder is for local docker-compose use only.
JWT_SECRET=dev-only-jwt-secret-please-override-in-production-0123456789
